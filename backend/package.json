{
  "name": "medflow-backend",
  "version": "1.0.0",
  "description": "MEDFLOW Hospital Resource Management Simulator Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:db": "ts-node --transpile-only src/db/testConnection.ts",
    "test:socket": "ts-node --transpile-only src/websocket/testSocketClient.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.11.3",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "socket.io-client": "^4.7.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
